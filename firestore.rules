rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function keepsExistingRole() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status_role', 'roleExpiresAt']);
    }

    function onlyInitializesBasicRole() {
      return !('status_role' in resource.data)
        && ('status_role' in request.resource.data)
        && request.resource.data.status_role == 'basic'
        && (!('roleExpiresAt' in request.resource.data) || request.resource.data.roleExpiresAt == null);
    }

    function keepsBasicExpiryEmpty() {
      return resource.data.status_role == 'basic'
        && (!('roleExpiresAt' in request.resource.data) || request.resource.data.roleExpiresAt == null);
    }

    match /users/{userId} {
      allow read: if isSignedInOwner(userId);
      allow create: if isSignedInOwner(userId)
        && (!('status_role' in request.resource.data) || request.resource.data.status_role == 'basic');
      allow update: if isSignedInOwner(userId) && (keepsExistingRole() || onlyInitializesBasicRole() || keepsBasicExpiryEmpty());
      allow delete: if false;

      match /chats/{chatId} {
        allow read, write: if isSignedInOwner(userId);
      }

      match /devices/{deviceId} {
        allow read, write: if isSignedInOwner(userId);
      }
    }
  }
}
